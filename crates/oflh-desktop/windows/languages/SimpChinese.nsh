; Tauri's SimpChinese installer messages, reworded for OFLH Desktop.
; Same keys as tauri-bundler's languages/SimpChinese.nsh; keep them in sync when
; Tauri adds strings. Tauri does not template these files, so use ${PRODUCTNAME}.
LangString addOrReinstall ${LANG_SIMPCHINESE} "添加或重新安装组件"
LangString alreadyInstalled ${LANG_SIMPCHINESE} "已安装"
LangString alreadyInstalledLong ${LANG_SIMPCHINESE} "${PRODUCTNAME} ${VERSION} 已安装。请选择要执行的操作，然后单击“下一步”继续。"
LangString appRunning ${LANG_SIMPCHINESE} "${PRODUCTNAME} 仍在运行。请关闭后重试。"
LangString appRunningOkKill ${LANG_SIMPCHINESE} "${PRODUCTNAME} 仍在运行。$\n单击“确定”将其关闭。"
LangString chooseMaintenanceOption ${LANG_SIMPCHINESE} "请选择要执行的操作。"
LangString chooseHowToInstall ${LANG_SIMPCHINESE} "请选择 ${PRODUCTNAME} 的安装方式。"
LangString createDesktop ${LANG_SIMPCHINESE} "创建桌面快捷方式"
LangString dontUninstall ${LANG_SIMPCHINESE} "不卸载"
LangString dontUninstallDowngrade ${LANG_SIMPCHINESE} "不卸载（必须先卸载才能降级）"
LangString failedToKillApp ${LANG_SIMPCHINESE} "无法关闭 ${PRODUCTNAME}。请关闭后重试。"
LangString installingWebview2 ${LANG_SIMPCHINESE} "正在安装 WebView2..."
LangString newerVersionInstalled ${LANG_SIMPCHINESE} "已安装更新版本的 ${PRODUCTNAME}。如需安装此旧版本，请先卸载当前版本。请选择要执行的操作，然后单击“下一步”继续。"
LangString older ${LANG_SIMPCHINESE} "较旧"
LangString olderOrUnknownVersionInstalled ${LANG_SIMPCHINESE} "系统中已安装${PRODUCTNAME}的$R4版本。建议先将其卸载。请选择要执行的操作，然后单击“下一步”继续。"
LangString silentDowngrades ${LANG_SIMPCHINESE} "静默模式下无法降级。请不带 /S 参数运行安装程序。$\n"
LangString unableToUninstall ${LANG_SIMPCHINESE} "卸载失败。"
LangString uninstallApp ${LANG_SIMPCHINESE} "卸载 ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_SIMPCHINESE} "安装前先卸载"
LangString unknown ${LANG_SIMPCHINESE} "未知"
LangString webview2AbortError ${LANG_SIMPCHINESE} "无法安装 WebView2，而应用需要它才能运行。请重新启动安装程序再试一次。"
LangString webview2DownloadError ${LANG_SIMPCHINESE} "错误：WebView2 下载失败 - $0"
LangString webview2DownloadSuccess ${LANG_SIMPCHINESE} "WebView2 引导程序已下载"
LangString webview2Downloading ${LANG_SIMPCHINESE} "正在下载 WebView2 引导程序..."
LangString webview2InstallError ${LANG_SIMPCHINESE} "错误：WebView2 安装失败，退出代码 $1"
LangString webview2InstallSuccess ${LANG_SIMPCHINESE} "WebView2 已安装"
LangString deleteAppData ${LANG_SIMPCHINESE} "同时删除设置和应用数据"
