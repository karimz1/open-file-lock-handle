{
  "name": "oflh-desktop-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src",
    "tauri": "cd .. && tauri",
    "test:ui": "playwright test",
    "screenshots:docs": "node scripts/capture-doc-screenshots.mjs",
    "format": "prettier --write src tests public scripts *.ts *.json index.html",
    "format:check": "prettier --check src tests public scripts *.ts *.json index.html"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.0.0",
    "@tauri-apps/api": "~2.11.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
