<?xml version="1.0" encoding="utf-8"?>
<!--
  Identity package ("package with external location") for OFLH Desktop.
  It installs no files: ExternalLocation points at the normal NSIS install
  folder, and the package only gives Windows 11 the identity it requires
  before it shows an IExplorerCommand handler in the top-level context menu.

  package.ps1 fills in @VERSION@. Unsigned builds keep the publisher below,
  which carries Microsoft's unsigned-package OID; signed builds replace the
  whole Publisher with the signing certificate's subject.
-->
<Package IgnorableNamespaces="uap uap10 desktop4 desktop5 com"
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">
  <Identity Name="KarimZouine.OFLHDesktop.ContextMenu"
    Publisher="CN=Karim Zouine, OID.2.25.311729368913984317654407730594956997722=1"
    Version="@VERSION@" ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>OFLH Desktop context menu</DisplayName>
    <PublisherDisplayName>Karim Zouine</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="OFLHDesktop" Executable="oflh-desktop.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="OFLH Desktop" Description="Find processes using files and folders"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="OflhInspectFile" Clsid="6F1A0C4E-3B7D-4E59-9C2A-0F1E5D8B7A31" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="OflhInspectFolder" Clsid="6F1A0C4E-3B7D-4E59-9C2A-0F1E5D8B7A31" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="OflhInspectBackground" Clsid="6F1A0C4E-3B7D-4E59-9C2A-0F1E5D8B7A31" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="OFLH Desktop context menu">
              <com:Class Id="6F1A0C4E-3B7D-4E59-9C2A-0F1E5D8B7A31" Path="shell-ext\oflh_shell_ext.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
